@startuml
'=====================DEFINE========================
!define ENTITY_Class ' Class entity
!define ENTITY_ClassUser ' Class entity
'=====================IMPORT========================
!include ../../GlobalSettings.puml
!include ../../common/Mediatr.puml
!include ../../common/EndpointClasses.puml
!include ../../common/IApplicationDbContext.puml
!include service/IClassService.puml
!include ../../entities/Class.puml
'=====================COMMAND========================
class UpdatePositionCommand {
    +ClassId: Guid
    +UserId: Guid
    +Position: ClassShareMode
}

class UpdatePositionCommandHandler {
    - _context: IApplicationDbContext
    - _classService: IClassService
