@startuml
!define ENTITY_Class ' Class entity

actor "User" as User
participant "Class UI" as UI
participant ClassEndpoints
participant UpdatePositionCommandHandler as Handler
participant IClassService
participant ApplicationDbContext
participant Database

User -> UI : Click "Update Position"
UI -> ClassEndpoints : PATCH /api/Class/{ClassId}/Members/{UserId}?position=xxx
ClassEndpoints -> Handler : Handle(UpdatePositionCommand)
Handler -> IClassService : GetClassOwnerAccess(ClassId)
IClassService -> ApplicationDbContext : Query Class & Owner
ApplicationDbContext -> Database : Query Class & Owner
Database --> ApplicationDbContext : Class, Owner
ApplicationDbContext --> IClassService : Class, Owner

alt Not found
    IClassService --> Handler : throw Error: CLASS_NOTFOUND
    Handler --> ClassEndpoints : Error: CLASS_NOTFOUND
    ClassEndpoints --> UI : 400 Bad Request (errorCode: CLASS_NOTFOUND)
    UI -> User : Error: Class not found
else Not owner
    IClassService --> Handler : throw Error: ONLY_OWNERS_CAN_UPDATE
    Handler --> ClassEndpoints : Error: ONLY_OWNERS_CAN_UPDATE
    ClassEndpoints --> UI : 400 Bad Request (errorCode: ONLY_OWNERS_CAN_UPDATE)
    UI -> User : Error: Only owner can update position
else Found
    IClassService --> Handler : Class, Owner
    Handler -> ApplicationDbContext : Update user position
    ApplicationDbContext -> Database : Update ClassUser.ShareMode
    Database --> ApplicationDbContext : OK
    ApplicationDbContext --> Handler : UpdatePositionDto
    Handler --> ClassEndpoints : UpdatePositionDto
    ClassEndpoints --> UI : 200 OK (ApiResponse<UpdatePositionDto>)
    UI -> User : Position updated successfully
end
@enduml 