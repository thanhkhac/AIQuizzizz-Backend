{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=CleanArchitectureBaseDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Debug", 
      "Microsoft.AspNetCore.Identity": "Debug", 
      "CleanArchitectureBase": "Debug" 
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "%JWT_SECRET_KEY%",
    "Issuer": "%JWT_ISSUER%",
    "Audience": "%JWT_AUDIENCE%",
    "ExpiryMinutes": 60
  }
}
