### Request: POST /api/QuestionSets/Create
############################################


POST {{baseUrl}}/api/QuestionSets/Create
Content-Type: {{contentType}}
Authorization: {{authorization}}

{
  "name": "name",
  "description": "description",
  "questions": [
    {
      "type": "type",
      "questionText": "questionText",
      "explainText": "explainText",
      "score": 0.0,
      "multipleChoices": [
        {
          "text": "text",
          "isAnswer": false
