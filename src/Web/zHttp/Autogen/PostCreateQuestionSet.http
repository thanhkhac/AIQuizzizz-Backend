        {
          "leftItem": "leftItem",
          "rightItem": "rightItem"
        }
      ],
      "orderingItems": [
        {
          "text": "text",
          "correctOrder": 0
        }
      ],
      "shortAnswer": "shortAnswer"
    }
  ]
}

