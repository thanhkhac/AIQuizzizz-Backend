# POST Users Register
POST {{Web_HostAddress}}/api/Authentiation/register
Content-Type: application/json

{
  "email": "sa@gmail.com",
  "password": "Sa@1234"
}

###

# POST Users Login
POST {{Web_HostAddress}}/api/Authentiation/login
Content-Type: application/json

{
  "email": "sa@gmail.com",
  "password": "Sa@1234"
}
###

# POST Users Refresh
POST {{Web_HostAddress}}/api/Users/refresh-token
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "refreshToken": "68df8c13-ddcb-4c9c-a0e8-b8d3e28017d5",
  "accessToken": "{{BearerToken}}"
}
###